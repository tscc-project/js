get_filename_component(_JSPP_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
add_library(JSpp::JS SHARED IMPORTED)
set_target_properties(JSpp::JS PROPERTIES
  IMPORTED_LOCATION "${_JSPP_PREFIX}/lib/libjs.so.0"
  INTERFACE_INCLUDE_DIRECTORIES "${_JSPP_PREFIX}/include")
set(JSpp_VERSION "0.0.0-dev")
